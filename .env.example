# Copy to .env to override defaults. No secrets are required for the local demo.
DATA_STORAGE=postgres          # postgres | firestore | none
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json   # only for DATA_STORAGE=firestore (never commit the file)
QUEUE_AUTHKEY=ingestbackend    # shared secret between api and backend queue manager; change outside local use
INGEST_API_KEY=                # empty = no auth; set to require an access_token header on POST /post/enqueue
CACHE_SIZE=10                  # posts per worker before a flush
FLUSH_IDLE_SECONDS=2           # flush a partial cache after this much queue idle time
SIM_RATE=8
SIM_REPEAT=1
DB_PORT=5434
API_PORT=8000
FRONTEND_PORT=8080
